N_ = 5;

% NRes: [CPU, RAM]
NRes = [| 24,  96   % Wezel 1: sredni, umiarkowany idle
        | 48, 176   % Wezel 2: duzy, wysoki idle, niska moc/W na CPU
        | 16,  64   % Wezel 3: maly
        | 12,  48   % Wezel 4: najmniejszy, niski idle
        | 28, 112   % Wezel 5: sredni/duzy
        |];

% Zasoby zajete przez kubelet, CNI, DaemonSet i system na AKTYWNYM wezle.
SystemReserve = [| 1, 4
                 | 1, 4
                 | 1, 4
                 | 1, 4
                 | 1, 4
                 |];

% Control plane jest poza optymalizowanym zbiorem workerow.
MustStayOn = [0, 0, 0, 0, 0];

IdlePower = [105, 165, 75, 62, 120];
MaxPower  = [275, 385, 205, 170, 300];

S = {WEB, DB};
Req = [| 1, 2   % WEB
       | 2, 8   % DB
       |];
MinReplicas = [16, 10];

% Scenariusz szybkiego wzrostu ruchu przez czas rozruchu nowej VM.
% WEB: +2 repliki/min; DB: +1 replika/min; start VM trwa 3 minuty.
VMStartMinutes = 3;
ExtraReplicasPerMinute = [2, 1];

ReserveScale = 1;               % w notebooku testowane 0,1,2,3
ShortagePenalty = [95, 130];   % jednostka modelowa: W-ekw. / replika
ShortagePenaltyMultiplier = 100; % 100% bazowej kary
SpreadPenalty = 4;             % W-ekw. / nadmiarowa replika
