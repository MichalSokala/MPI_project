% =====================================================================
% PARAMETRY INFRASTRUKTURY CHMURY
% =====================================================================
C_ = 5;  % Aktywujemy wszystkie 5 klastrów

L = {KRK, WAW, POZ, WROC, GDN};

% Przypisanie klastrów do konkretnych lokalizacji z enum L
CL = [KRK, WAW, POZ, WROC, GDN];

% Zasoby klastrów: [CPU, RAM]
% Różnicujemy wielkość klastrów (Warszawa największa, Gdańsk i Wrocław mniejsze)
CRes = [| 32, 128   % Klaster 1: Kraków (KRK)
        | 64, 256   % Klaster 2: Warszawa (WAW)
        | 16,  64   % Klaster 3: Poznań (POZ)
        | 12,  32   % Klaster 4: Wrocław (WROC) - Celowo mały, braki zasobów
        | 24,  96 |]; % Klaster 5: Gdańsk (GDN)

% Macierz  odległości (w kilometrach)
% Kolejność: KRK (1), WAW (2), POZ (3), WROC (4), GDN (5)
D = [|   0, 293, 400, 270, 540   % Kraków (KRK)
     | 293,   0, 310, 348, 340   % Warszawa (WAW)
     | 400, 310,   0, 180, 300   % Poznań (POZ)
     | 270, 348, 180,   0, 480   % Wrocław (WROC)
     | 540, 340, 300, 480,   0 |]; % Gdańsk (GDN)

% =====================================================================
% PARAMETRY USŁUG
% =====================================================================
S = {WEB, DB, VIDEO};

% Wymagane zasoby przez pojedynczą instancję danej usługi: [CPU, RAM]
Req = [| 1,  2    % WEB
       | 2,  8    % DB
       | 4, 16 |];  % VIDEO

% Wydajność obsługowa jednej instancji (ile jednostek ruchu obsłuży 1 instancja)
ServiceRate = [10, 10, 10]; 

% Maksymalna tolerowana odległość (opóźnienie?) transmisji (w km) dla usług: [WEB, DB, VIDEO]
MaxDelay = [200, 200, 200];  

% =====================================================================
% RUCH I ZAPOTRZEBOWANIE (DEMAND)
% =====================================================================

% Ruch napływający lokalnie do każdego klastra dla usług: [WEB, DB, VIDEO]
Demand = [| 30, 10, 4   % Kraków (Spory ruch, duże zasoby)
          | 50, 20, 8   % Warszawa (Największy ruch)
          | 15,  5, 2   % Poznań (Umiarkowany ruch)
          | 40, 15, 6   % Wrocław (Duży ruch, ale ma za MAŁO zasobów u siebie!)
          | 20,  5, 2 |]; % Gdańsk (Stabilny ruch)

% =====================================================================
% KOSZTY JEDNOSTKOWE I WAGI
% =====================================================================
UnitTransCost = 0.02;        % Koszt za przesłanie 1 jednostki ruchu na 1 km
UnitCompCost = [1.5, 0.4];   % Koszt jednostkowy zasobów: [CPU, RAM]

WeightComp = 1.0; 
WeightTrans = 1.0;